# Normalisation : texte en LF partout (Godot est sensible aux fins de ligne dans les diffs)
* text=auto eol=lf

*.gd       text eol=lf
*.gdshader text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.cfg      text eol=lf
*.godot    text eol=lf
*.import   text eol=lf
*.uid      text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.svg      text eol=lf
*.txt      text eol=lf

# Binaires : stockés directement dans git (Git LFS désactivé : envoi LFS impossible depuis l environnement de Claude)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.bmp   binary
*.tga   binary
*.exr   binary
*.hdr   binary
*.psd   binary
*.kra   binary
*.aseprite binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.flac  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.glb   binary
*.gltf  binary
*.fbx   binary
*.obj   binary
*.blend binary
*.mp4   binary
*.webm  binary
*.ogv   binary

# Fichiers fournis par l'addon GUT : versionnés normalement (pas LFS),
# pour que le dépôt reste utilisable sans LFS pour les tests en CI.
addons/gut/**/*.png -filter -diff -merge binary
addons/gut/**/*.ttf -filter -diff -merge binary
addons/gut/**/*.otf -filter -diff -merge binary

# Exclusions des archives `git archive`
.github/       export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
