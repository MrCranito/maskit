metadata/enemy_meta = {"kind": "cv_acrobat", "name": "Acrobate sanguinaire", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 107, "head_px": 45, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [118.0, 93.9], "se": [93.1, 99.8], "s": [70.0, 90.9], "sw": [62.0, 72.5], "w": [74.0, 55.2], "nw": [98.9, 49.4], "n": [122.0, 58.2], "ne": [130.0, 76.7]}, "corpse_bbox_px": {"e": [0, 88, 153, 161], "se": [0, 88, 153, 161], "s": [41, 70, 192, 169], "sw": [41, 70, 192, 169], "w": [41, 70, 192, 169], "nw": [39, 89, 192, 186], "n": [39, 89, 192, 186], "ne": [0, 104, 151, 180]}, "atlas": "res://assets/sprites/enemies/cv_acrobat/cv_acrobat_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
