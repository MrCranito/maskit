metadata/enemy_meta = {"kind": "cv_acrobat", "name": "Acrobate sanguinaire", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 106, "head_px": 39, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [124.7, 97.8], "se": [106.0, 109.7], "s": [81.5, 108.3], "sw": [65.5, 94.5], "w": [67.3, 76.3], "nw": [86.0, 64.4], "n": [110.5, 65.7], "ne": [126.5, 79.6]}, "corpse_bbox_px": {"e": [16, 93, 150, 161], "se": [16, 93, 150, 161], "s": [41, 80, 177, 169], "sw": [41, 80, 177, 169], "w": [41, 80, 177, 169], "nw": [42, 92, 176, 174], "n": [42, 92, 176, 174], "ne": [15, 107, 151, 174]}, "atlas": "res://assets/sprites/enemies/cv_acrobat/cv_acrobat_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
