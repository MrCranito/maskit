metadata/enemy_meta = {"kind": "cv_big_plush", "name": "Grosse peluche", "frame_size": [256, 256], "feet_offset": [128, 181], "display_height": 147.7, "world_per_px": 0.576875, "height_px": 138, "head_px": 58, "fps": {"idle": 7, "run": 10, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [160.7, 170.4], "se": [136.5, 183.1], "s": [107.2, 179.3], "sw": [90.2, 161.3], "w": [95.3, 139.5], "nw": [119.5, 126.9], "n": [148.8, 130.7], "ne": [165.8, 148.7]}, "corpse_bbox_px": {"e": [18, 111, 208, 215], "se": [18, 111, 208, 215], "s": [52, 101, 237, 220], "sw": [52, 101, 237, 220], "w": [52, 101, 237, 220], "nw": [48, 119, 238, 238], "n": [48, 119, 238, 238], "ne": [19, 130, 204, 233]}, "atlas": "res://assets/sprites/enemies/cv_big_plush/cv_big_plush_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
