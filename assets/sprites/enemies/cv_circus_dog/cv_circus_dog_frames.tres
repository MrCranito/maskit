metadata/enemy_meta = {"kind": "cv_circus_dog", "name": "Chien de cirque", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 103, "head_px": 59, "fps": {"idle": 7, "run": 17, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [167.5, 72.0], "se": [146.5, 109.5], "s": [96.0, 125.1], "sw": [45.5, 109.5], "w": [24.5, 72.0], "nw": [45.5, 34.4], "n": [96.0, 18.9], "ne": [146.5, 34.4]}, "corpse_bbox_px": {"e": [34, 66, 156, 190], "se": [40, 77, 166, 188], "s": [28, 72, 160, 174], "sw": [31, 68, 152, 178], "w": [36, 59, 158, 175], "nw": [26, 61, 152, 161], "n": [32, 77, 164, 165], "ne": [40, 60, 161, 184]}, "atlas": "res://assets/sprites/enemies/cv_circus_dog/cv_circus_dog_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
