metadata/enemy_meta = {"kind": "cv_circus_dog", "name": "Chien de cirque", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 119, "head_px": 43, "fps": {"idle": 7, "run": 17, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [182.7, 87.6], "se": [157.3, 133.1], "s": [96.0, 152.0], "sw": [34.7, 133.1], "w": [9.3, 87.6], "nw": [34.7, 42.0], "n": [96.0, 23.1], "ne": [157.3, 42.0]}, "corpse_bbox_px": {"e": [31, 81, 161, 187], "se": [40, 78, 165, 186], "s": [32, 72, 155, 179], "sw": [33, 73, 154, 180], "w": [31, 66, 162, 173], "nw": [27, 67, 151, 164], "n": [37, 78, 160, 170], "ne": [38, 69, 159, 182]}, "atlas": "res://assets/sprites/enemies/cv_circus_dog/cv_circus_dog_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
