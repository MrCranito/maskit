metadata/enemy_meta = {"kind": "cv_fairground_being", "name": "L'Être forain", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 157, "head_px": 27, "fps": {"idle": 7, "run": 13, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [201.6, 110.2], "se": [163.5, 153.7], "s": [95.3, 164.4], "sw": [36.8, 136.1], "w": [22.4, 85.4], "nw": [60.5, 42.0], "n": [128.7, 31.3], "ne": [187.2, 59.5]}, "corpse_bbox_px": {"e": [0, 101, 177, 197], "se": [0, 101, 177, 197], "s": [46, 75, 224, 197], "sw": [46, 75, 224, 197], "w": [46, 75, 224, 197], "nw": [47, 104, 224, 205], "n": [47, 104, 224, 205], "ne": [0, 104, 178, 224]}, "atlas": "res://assets/sprites/enemies/cv_fairground_being/cv_fairground_being_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
