metadata/enemy_meta = {"kind": "cv_fire_clown", "name": "Le Clown de feu", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 124, "head_px": 46, "fps": {"idle": 7, "run": 12, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [166.6, 114.3], "se": [156.0, 144.7], "s": [119.7, 160.6], "sw": [78.9, 152.7], "w": [57.4, 125.8], "nw": [68.0, 95.4], "n": [104.3, 79.5], "ne": [145.1, 87.3]}, "corpse_bbox_px": {"e": [25, 107, 175, 187], "se": [25, 107, 175, 187], "s": [50, 98, 199, 193], "sw": [50, 98, 199, 193], "w": [50, 98, 199, 193], "nw": [49, 109, 199, 201], "n": [49, 109, 199, 201], "ne": [25, 122, 174, 197]}, "atlas": "res://assets/sprites/enemies/cv_fire_clown/cv_fire_clown_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
