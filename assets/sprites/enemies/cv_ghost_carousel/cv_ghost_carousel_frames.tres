metadata/enemy_meta = {"kind": "cv_ghost_carousel", "name": "Manège fantôme", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 140, "head_px": 41, "fps": {"idle": 7, "run": 10, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [188.9, 79.8], "se": [166.4, 120.2], "s": [112.0, 136.9], "sw": [57.6, 120.2], "w": [35.1, 79.8], "nw": [57.6, 39.4], "n": [112.0, 22.6], "ne": [166.4, 39.4]}, "corpse_bbox_px": {"e": [52, 42, 199, 174], "se": [62, 41, 222, 182], "s": [89, 41, 213, 224], "sw": [79, 41, 178, 224], "w": [25, 42, 172, 224], "nw": [2, 43, 162, 198], "n": [11, 43, 135, 203], "ne": [46, 43, 145, 195]}, "atlas": "res://assets/sprites/enemies/cv_ghost_carousel/cv_ghost_carousel_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
