metadata/enemy_meta = {"kind": "cv_penumbra", "name": "Pénombre", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 112, "head_px": 45, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [168.1, 80.3], "se": [186.0, 130.2], "s": [151.2, 174.9], "sw": [84.1, 188.2], "w": [23.9, 162.4], "nw": [6.0, 112.5], "n": [40.8, 67.8], "ne": [107.9, 54.4]}, "corpse_bbox_px": {"e": [16, 88, 153, 171], "se": [16, 88, 153, 171], "s": [39, 81, 174, 171], "sw": [39, 81, 174, 171], "w": [39, 81, 174, 171], "nw": [38, 88, 176, 175], "n": [38, 88, 176, 175], "ne": [18, 88, 153, 171]}, "atlas": "res://assets/sprites/enemies/cv_penumbra/cv_penumbra_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
