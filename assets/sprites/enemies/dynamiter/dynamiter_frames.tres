metadata/enemy_meta = {"kind": "dynamiter", "name": "Dynamiteur", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 101, "head_px": 45, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [136.1, 78.1], "se": [135.6, 102.6], "s": [111.8, 119.7], "sw": [78.8, 119.3], "w": [55.9, 101.6], "nw": [56.4, 77.1], "n": [80.2, 60.0], "ne": [113.2, 60.4]}, "corpse_bbox_px": {"e": [27, 91, 149, 161], "se": [27, 91, 149, 161], "s": [45, 93, 165, 166], "sw": [45, 93, 165, 166], "w": [45, 93, 165, 166], "nw": [43, 94, 165, 167], "n": [43, 94, 165, 167], "ne": [27, 105, 147, 165]}, "atlas": "res://assets/sprites/enemies/dynamiter/dynamiter_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la lame (image attack 3)."}
