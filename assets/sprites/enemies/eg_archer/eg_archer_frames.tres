metadata/enemy_meta = {"kind": "eg_archer", "name": "Archer sable", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 77, "head_px": 67, "fps": {"idle": 7, "run": 12, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [138.9, 82.2], "se": [127.6, 105.2], "s": [97.8, 115.4], "sw": [66.9, 107.0], "w": [53.1, 84.9], "nw": [64.4, 62.0], "n": [94.2, 51.7], "ne": [125.1, 60.1]}, "corpse_bbox_px": {"e": [35, 58, 143, 157], "se": [35, 58, 143, 157], "s": [49, 88, 171, 163], "sw": [49, 88, 171, 163], "w": [49, 88, 171, 163], "nw": [48, 97, 157, 176], "n": [48, 97, 157, 176], "ne": [21, 88, 143, 166]}, "atlas": "res://assets/sprites/enemies/eg_archer/eg_archer_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
