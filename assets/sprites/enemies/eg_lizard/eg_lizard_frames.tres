metadata/enemy_meta = {"kind": "eg_lizard", "name": "Lézard des sables", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 90, "head_px": 67, "fps": {"idle": 7, "run": 18, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [190.4, 121.5], "se": [162.9, 168.4], "s": [96.3, 189.0], "sw": [29.4, 168.6], "w": [1.6, 119.1], "nw": [29.1, 69.4], "n": [95.7, 48.7], "ne": [162.6, 69.1]}, "corpse_bbox_px": {"e": [11, 79, 178, 155], "se": [35, 91, 189, 173], "s": [94, 89, 157, 192], "sw": [49, 107, 157, 192], "w": [14, 125, 181, 192], "nw": [3, 98, 153, 192], "n": [35, 72, 96, 192], "ne": [38, 66, 143, 192]}, "atlas": "res://assets/sprites/enemies/eg_lizard/eg_lizard_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
