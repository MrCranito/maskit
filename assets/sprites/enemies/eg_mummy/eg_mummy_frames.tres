metadata/enemy_meta = {"kind": "eg_mummy", "name": "Momie étouffée", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 88, "head_px": 83, "fps": {"idle": 7, "run": 9, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [141.9, 139.8], "se": [126.3, 153.4], "s": [102.2, 154.8], "sw": [83.9, 143.2], "w": [82.1, 125.3], "nw": [97.7, 111.7], "n": [121.8, 110.3], "ne": [140.1, 122.0]}, "corpse_bbox_px": {"e": [40, 107, 171, 187], "se": [40, 107, 171, 187], "s": [52, 99, 182, 194], "sw": [52, 99, 182, 194], "w": [52, 99, 182, 194], "nw": [53, 110, 184, 201], "n": [53, 110, 184, 201], "ne": [42, 123, 172, 197]}, "atlas": "res://assets/sprites/enemies/eg_mummy/eg_mummy_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
