metadata/enemy_meta = {"kind": "eg_pharaoh", "name": "Le Pharaon éternel", "frame_size": [276, 276], "feet_offset": [138, 196], "display_height": 258.4, "world_per_px": 0.936377, "height_px": 149, "head_px": 60, "fps": {"idle": 6, "run": 10, "attack": 12, "hit": 14, "death": 9}, "frames": {"idle": 4, "run": 6, "attack": 6, "hit": 3, "death": 6}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [299.2, 152.5], "se": [238.1, 232.9], "s": [118.4, 257.7], "sw": [10.2, 212.3], "w": [-23.2, 123.4], "nw": [37.9, 42.9], "n": [157.6, 18.1], "ne": [265.8, 63.5]}, "corpse_bbox_px": {"e": [36, 66, 216, 267], "se": [36, 66, 216, 267], "s": [60, 62, 239, 267], "sw": [60, 62, 239, 267], "w": [60, 62, 239, 267], "nw": [60, 107, 240, 276], "n": [60, 107, 240, 276], "ne": [37, 111, 216, 276]}, "atlas": "res://assets/sprites/enemies/eg_pharaoh/eg_pharaoh_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
