metadata/enemy_meta = {"kind": "eg_scarab", "name": "Scarabée géant", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 97, "head_px": 79, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [158.5, 104.9], "se": [140.2, 137.7], "s": [96.0, 151.3], "sw": [51.8, 137.7], "w": [33.5, 104.9], "nw": [51.8, 72.0], "n": [96.0, 58.4], "ne": [140.2, 72.0]}, "corpse_bbox_px": {"e": [55, 100, 161, 157], "se": [57, 99, 158, 176], "s": [64, 94, 132, 185], "sw": [47, 96, 130, 184], "w": [31, 100, 137, 169], "nw": [34, 90, 135, 158], "n": [60, 73, 128, 166], "ne": [62, 77, 145, 163]}, "atlas": "res://assets/sprites/enemies/eg_scarab/eg_scarab_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
