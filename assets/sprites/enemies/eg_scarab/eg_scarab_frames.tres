metadata/enemy_meta = {"kind": "eg_scarab", "name": "Scarabée géant", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 87, "head_px": 78, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [154.1, 108.4], "se": [137.1, 138.9], "s": [96.0, 151.5], "sw": [54.9, 138.9], "w": [37.9, 108.4], "nw": [54.9, 77.9], "n": [96.0, 65.2], "ne": [137.1, 77.9]}, "corpse_bbox_px": {"e": [55, 100, 148, 158], "se": [57, 98, 146, 160], "s": [66, 93, 125, 171], "sw": [58, 95, 130, 169], "w": [44, 99, 137, 156], "nw": [45, 98, 135, 158], "n": [67, 83, 126, 165], "ne": [62, 87, 134, 162]}, "atlas": "res://assets/sprites/enemies/eg_scarab/eg_scarab_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
