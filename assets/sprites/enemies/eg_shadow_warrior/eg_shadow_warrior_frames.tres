metadata/enemy_meta = {"kind": "eg_shadow_warrior", "name": "Guerrier de l'ombre", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 117, "head_px": 54, "fps": {"idle": 7, "run": 15, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [162.2, 84.4], "se": [201.7, 127.5], "s": [188.7, 178.7], "sw": [130.7, 208.1], "w": [61.8, 198.4], "nw": [22.3, 155.3], "n": [35.3, 104.1], "ne": [93.3, 74.7]}, "corpse_bbox_px": {"e": [17, 102, 176, 224], "se": [17, 102, 176, 224], "s": [48, 75, 206, 197], "sw": [48, 75, 206, 197], "w": [48, 75, 206, 197], "nw": [48, 75, 206, 206], "n": [48, 75, 206, 206], "ne": [18, 122, 176, 224]}, "atlas": "res://assets/sprites/enemies/eg_shadow_warrior/eg_shadow_warrior_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
