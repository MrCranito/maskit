metadata/enemy_meta = {"kind": "eg_skeleton", "name": "Squelette rôdeur", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 71, "head_px": 73, "fps": {"idle": 7, "run": 13, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [127.4, 115.8], "se": [126.8, 135.0], "s": [108.1, 148.2], "sw": [82.3, 147.7], "w": [64.6, 133.8], "nw": [65.2, 114.6], "n": [83.9, 101.4], "ne": [109.7, 101.9]}, "corpse_bbox_px": {"e": [35, 90, 143, 167], "se": [35, 90, 143, 167], "s": [49, 81, 156, 169], "sw": [49, 81, 156, 169], "w": [49, 81, 156, 169], "nw": [48, 91, 157, 178], "n": [48, 91, 157, 178], "ne": [37, 101, 143, 175]}, "atlas": "res://assets/sprites/enemies/eg_skeleton/eg_skeleton_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
