metadata/enemy_meta = {"kind": "eg_sun_priest", "name": "Prêtre du soleil", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 113, "head_px": 59, "fps": {"idle": 7, "run": 11, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [231.1, 86.5], "se": [187.6, 146.4], "s": [99.9, 166.0], "sw": [19.2, 133.7], "w": [-7.1, 68.5], "nw": [36.4, 8.5], "n": [124.1, -11.0], "ne": [204.8, 21.3]}, "corpse_bbox_px": {"e": [33, 56, 171, 197], "se": [33, 56, 171, 197], "s": [53, 56, 191, 194], "sw": [53, 56, 191, 194], "w": [53, 56, 191, 194], "nw": [53, 91, 191, 200], "n": [53, 91, 191, 200], "ne": [33, 92, 172, 221]}, "atlas": "res://assets/sprites/enemies/eg_sun_priest/eg_sun_priest_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
