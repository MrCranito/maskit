metadata/enemy_meta = {"kind": "eg_viper", "name": "Vipère des sables", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 63, "head_px": 91, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [160.2, 123.7], "se": [141.4, 157.4], "s": [96.0, 171.4], "sw": [50.6, 157.4], "w": [31.8, 123.7], "nw": [50.6, 89.9], "n": [96.0, 75.9], "ne": [141.4, 89.9]}, "corpse_bbox_px": {"e": [58, 97, 187, 152], "se": [62, 102, 176, 180], "s": [71, 101, 135, 192], "sw": [37, 104, 133, 192], "w": [5, 111, 134, 158], "nw": [16, 89, 130, 161], "n": [57, 64, 121, 162], "ne": [59, 72, 155, 159]}, "atlas": "res://assets/sprites/enemies/eg_viper/eg_viper_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
