metadata/enemy_meta = {"kind": "eg_viper", "name": "Vipère des sables", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 81, "head_px": 75, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [171.1, 127.6], "se": [149.1, 167.1], "s": [96.0, 183.4], "sw": [42.9, 167.1], "w": [20.9, 127.6], "nw": [42.9, 88.2], "n": [96.0, 71.9], "ne": [149.1, 88.2]}, "corpse_bbox_px": {"e": [57, 102, 192, 153], "se": [61, 100, 187, 191], "s": [70, 100, 131, 192], "sw": [25, 103, 135, 192], "w": [0, 110, 135, 163], "nw": [4, 81, 131, 163], "n": [61, 54, 122, 163], "ne": [57, 63, 167, 160]}, "atlas": "res://assets/sprites/enemies/eg_viper/eg_viper_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
