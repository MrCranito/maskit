metadata/enemy_meta = {"kind": "fw_bandit", "name": "Bandit", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 101, "head_px": 48, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [153.9, 73.9], "se": [136.8, 104.2], "s": [95.8, 116.7], "sw": [54.9, 104.0], "w": [38.1, 73.6], "nw": [55.2, 43.2], "n": [96.2, 30.7], "ne": [137.1, 43.4]}, "corpse_bbox_px": {"e": [22, 91, 150, 162], "se": [22, 91, 150, 162], "s": [43, 88, 170, 168], "sw": [43, 88, 170, 168], "w": [43, 88, 170, 168], "nw": [42, 93, 170, 173], "n": [42, 93, 170, 173], "ne": [22, 105, 149, 169]}, "atlas": "res://assets/sprites/enemies/fw_bandit/fw_bandit_atlas.png", "source": "art/blender/bestiary/far_west/build_fw_bestiary.py", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la gueule (image attack 3)."}
