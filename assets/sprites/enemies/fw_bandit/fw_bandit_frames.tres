metadata/enemy_meta = {"kind": "fw_bandit", "name": "Bandit", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 117, "head_px": 37, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [155.2, 74.2], "se": [137.8, 105.4], "s": [95.9, 118.2], "sw": [54.0, 105.3], "w": [36.8, 74.1], "nw": [54.2, 43.0], "n": [96.1, 30.1], "ne": [138.0, 43.1]}, "corpse_bbox_px": {"e": [17, 84, 150, 162], "se": [17, 84, 150, 162], "s": [43, 81, 173, 167], "sw": [43, 81, 173, 167], "w": [43, 81, 173, 167], "nw": [42, 93, 175, 180], "n": [42, 93, 175, 180], "ne": [19, 105, 149, 176]}, "atlas": "res://assets/sprites/enemies/fw_bandit/fw_bandit_atlas.png", "source": "art/blender/bestiary/far_west/build_fw_bestiary.py", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la gueule (image attack 3)."}
