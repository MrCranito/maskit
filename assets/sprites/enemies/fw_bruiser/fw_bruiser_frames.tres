metadata/enemy_meta = {"kind": "fw_bruiser", "name": "Robuste", "frame_size": [192, 192], "feet_offset": [96, 143], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 138, "head_px": 26, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [174.1, 85.1], "se": [166.8, 130.9], "s": [117.9, 159.4], "sw": [56.3, 153.9], "w": [17.9, 117.7], "nw": [25.2, 71.8], "n": [74.1, 43.3], "ne": [135.7, 48.8]}, "corpse_bbox_px": {"e": [8, 79, 161, 174], "se": [8, 79, 161, 174], "s": [33, 86, 185, 192], "sw": [33, 86, 185, 192], "w": [33, 86, 185, 192], "nw": [31, 91, 184, 192], "n": [31, 91, 184, 192], "ne": [7, 101, 159, 183]}, "atlas": "res://assets/sprites/enemies/fw_bruiser/fw_bruiser_atlas.png", "source": "art/blender/bestiary/far_west/build_fw_bestiary.py", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la gueule (image attack 3)."}
