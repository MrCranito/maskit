metadata/enemy_meta = {"kind": "fw_buffalo", "name": "Le Buffle", "frame_size": [288, 288], "feet_offset": [144, 191], "display_height": 166.1, "world_per_px": 0.576875, "height_px": 173, "head_px": 62, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [227.7, 30.9], "se": [234.9, 84.6], "s": [188.9, 126.4], "sw": [116.5, 131.8], "w": [60.3, 97.6], "nw": [53.1, 43.8], "n": [99.1, 2.0], "ne": [171.5, -3.3]}, "corpse_bbox_px": {"e": [47, 45, 288, 201], "se": [47, 45, 288, 201], "s": [37, 125, 263, 288], "sw": [37, 125, 263, 288], "w": [37, 125, 263, 288], "nw": [0, 123, 241, 273], "n": [0, 123, 241, 273], "ne": [25, 22, 251, 199]}, "atlas": "res://assets/sprites/enemies/fw_buffalo/fw_buffalo_atlas.png", "source": "art/blender/bestiary/far_west/build_fw_bestiary.py", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la gueule (image attack 3)."}
