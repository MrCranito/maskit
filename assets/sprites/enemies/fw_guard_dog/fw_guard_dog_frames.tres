metadata/enemy_meta = {"kind": "fw_guard_dog", "name": "Chien de garde", "frame_size": [224, 224], "feet_offset": [112, 150], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 106, "head_px": 68, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [204.0, 87.5], "se": [177.0, 135.8], "s": [112.0, 155.8], "sw": [47.0, 135.8], "w": [20.0, 87.5], "nw": [47.0, 39.1], "n": [112.0, 19.1], "ne": [177.0, 39.1]}, "corpse_bbox_px": {"e": [55, 72, 202, 156], "se": [55, 72, 202, 156], "s": [57, 116, 186, 209], "sw": [57, 116, 186, 209], "w": [57, 116, 186, 209], "nw": [22, 119, 170, 197], "n": [22, 119, 170, 197], "ne": [38, 52, 167, 161]}, "atlas": "res://assets/sprites/enemies/fw_guard_dog/fw_guard_dog_atlas.png", "source": "art/blender/bestiary/far_west/build_fw_bestiary.py", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la gueule (image attack 3)."}
