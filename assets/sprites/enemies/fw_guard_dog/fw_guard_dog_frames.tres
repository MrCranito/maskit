metadata/enemy_meta = {"kind": "fw_guard_dog", "name": "Chien de garde", "frame_size": [224, 224], "feet_offset": [112, 150], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 117, "head_px": 65, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [204.7, 100.0], "se": [177.6, 148.7], "s": [112.0, 168.9], "sw": [46.4, 148.7], "w": [19.3, 100.0], "nw": [46.4, 51.3], "n": [112.0, 31.1], "ne": [177.6, 51.3]}, "corpse_bbox_px": {"e": [55, 74, 194, 165], "se": [55, 74, 194, 165], "s": [56, 117, 187, 197], "sw": [56, 117, 187, 197], "w": [56, 117, 187, 197], "nw": [30, 112, 169, 196], "n": [30, 112, 169, 196], "ne": [37, 68, 168, 159]}, "atlas": "res://assets/sprites/enemies/fw_guard_dog/fw_guard_dog_atlas.png", "source": "art/blender/bestiary/far_west/build_fw_bestiary.py", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la gueule (image attack 3)."}
