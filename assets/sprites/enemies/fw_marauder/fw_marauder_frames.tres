metadata/enemy_meta = {"kind": "fw_marauder", "name": "Maraudeur", "frame_size": [224, 224], "feet_offset": [112, 153], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 108, "head_px": 77, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [223.3, 105.7], "se": [190.7, 164.2], "s": [112.0, 188.4], "sw": [33.3, 164.2], "w": [0.7, 105.7], "nw": [33.3, 47.2], "n": [112.0, 23.0], "ne": [190.7, 47.2]}, "corpse_bbox_px": {"e": [50, 71, 208, 165], "se": [50, 71, 208, 165], "s": [51, 113, 197, 216], "sw": [51, 113, 197, 216], "w": [51, 113, 197, 216], "nw": [16, 112, 174, 199], "n": [16, 112, 174, 199], "ne": [27, 51, 172, 166]}, "atlas": "res://assets/sprites/enemies/fw_marauder/fw_marauder_atlas.png", "source": "art/blender/bestiary/far_west/build_fw_bestiary.py", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la gueule (image attack 3)."}
