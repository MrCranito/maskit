metadata/enemy_meta = {"kind": "fw_raider", "name": "Pillard", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 105, "head_px": 46, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [189.5, 136.0], "se": [155.5, 183.0], "s": [86.6, 198.5], "sw": [23.3, 173.2], "w": [2.5, 122.0], "nw": [36.5, 74.9], "n": [105.4, 59.5], "ne": [168.7, 84.8]}, "corpse_bbox_px": {"e": [19, 55, 154, 163], "se": [19, 55, 154, 163], "s": [40, 72, 172, 169], "sw": [40, 72, 172, 169], "w": [40, 72, 172, 169], "nw": [38, 90, 173, 174], "n": [38, 90, 173, 174], "ne": [20, 78, 153, 177]}, "atlas": "res://assets/sprites/enemies/fw_raider/fw_raider_atlas.png", "source": "art/blender/bestiary/far_west/build_fw_bestiary.py", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la gueule (image attack 3)."}
