metadata/enemy_meta = {"kind": "ice_bear", "name": "Ours des neiges muté", "frame_size": [256, 256], "feet_offset": [128, 181], "display_height": 147.7, "world_per_px": 0.576875, "height_px": 139, "head_px": 83, "fps": {"idle": 7, "run": 11, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [259.9, 135.1], "se": [221.3, 204.4], "s": [128.0, 233.1], "sw": [34.7, 204.4], "w": [-3.9, 135.1], "nw": [34.7, 65.7], "n": [128.0, 37.0], "ne": [221.3, 65.7]}, "corpse_bbox_px": {"e": [50, 68, 251, 193], "se": [50, 68, 251, 193], "s": [52, 122, 223, 256], "sw": [52, 122, 223, 256], "w": [52, 122, 223, 256], "nw": [5, 121, 206, 245], "n": [5, 121, 206, 245], "ne": [33, 41, 204, 193]}, "atlas": "res://assets/sprites/enemies/ice_bear/ice_bear_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
