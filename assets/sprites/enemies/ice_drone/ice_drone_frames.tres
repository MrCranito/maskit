metadata/enemy_meta = {"kind": "ice_drone", "name": "Drone de froid", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 91, "head_px": 46, "fps": {"idle": 7, "run": 12, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [117.4, 83.9], "se": [111.1, 95.1], "s": [96.0, 99.8], "sw": [80.9, 95.1], "w": [74.6, 83.9], "nw": [80.9, 72.7], "n": [96.0, 68.0], "ne": [111.1, 72.7]}, "corpse_bbox_px": {"e": [35, 84, 143, 182], "se": [35, 84, 143, 182], "s": [66, 48, 128, 190], "sw": [66, 48, 128, 190], "w": [66, 48, 128, 190], "nw": [49, 51, 157, 189], "n": [49, 51, 157, 189], "ne": [64, 71, 126, 192]}, "atlas": "res://assets/sprites/enemies/ice_drone/ice_drone_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
