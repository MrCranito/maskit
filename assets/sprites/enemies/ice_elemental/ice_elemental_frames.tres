metadata/enemy_meta = {"kind": "ice_elemental", "name": "Élémentaire de glace", "frame_size": [256, 256], "feet_offset": [128, 181], "display_height": 147.7, "world_per_px": 0.576875, "height_px": 91, "head_px": 103, "fps": {"idle": 7, "run": 10, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [155.3, 194.7], "se": [134.5, 205.1], "s": [109.9, 201.6], "sw": [95.9, 186.1], "w": [100.7, 167.8], "nw": [121.5, 157.4], "n": [146.1, 161.0], "ne": [160.1, 176.4]}, "corpse_bbox_px": {"e": [47, 118, 198, 220], "se": [47, 118, 198, 220], "s": [61, 105, 208, 224], "sw": [61, 105, 208, 224], "w": [61, 105, 208, 224], "nw": [58, 126, 209, 232], "n": [58, 126, 209, 232], "ne": [48, 130, 195, 229]}, "atlas": "res://assets/sprites/enemies/ice_elemental/ice_elemental_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
