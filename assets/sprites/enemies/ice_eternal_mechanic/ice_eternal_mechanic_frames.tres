metadata/enemy_meta = {"kind": "ice_eternal_mechanic", "name": "Mécanicien de l'Éternité", "frame_size": [256, 256], "feet_offset": [128, 181], "display_height": 147.7, "world_per_px": 0.576875, "height_px": 111, "head_px": 83, "fps": {"idle": 7, "run": 11, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [184.9, 121.1], "se": [169.7, 151.4], "s": [130.1, 164.9], "sw": [89.2, 153.6], "w": [71.1, 124.1], "nw": [86.3, 93.8], "n": [125.9, 80.3], "ne": [166.8, 91.6]}, "corpse_bbox_px": {"e": [39, 110, 202, 217], "se": [39, 110, 202, 217], "s": [57, 104, 227, 222], "sw": [57, 104, 227, 222], "w": [57, 104, 227, 222], "nw": [54, 121, 217, 234], "n": [54, 121, 217, 234], "ne": [29, 135, 199, 233]}, "atlas": "res://assets/sprites/enemies/ice_eternal_mechanic/ice_eternal_mechanic_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
