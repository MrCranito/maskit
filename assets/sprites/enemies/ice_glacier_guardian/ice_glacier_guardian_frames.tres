metadata/enemy_meta = {"kind": "ice_glacier_guardian", "name": "Gardien des glaces", "frame_size": [288, 288], "feet_offset": [144, 204], "display_height": 166.1, "world_per_px": 0.576875, "height_px": 119, "head_px": 100, "fps": {"idle": 7, "run": 10, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [180.3, 204.3], "se": [152.9, 218.2], "s": [120.3, 213.7], "sw": [101.6, 193.3], "w": [107.7, 169.1], "nw": [135.1, 155.2], "n": [167.7, 159.7], "ne": [186.4, 180.1]}, "corpse_bbox_px": {"e": [50, 122, 233, 249], "se": [50, 122, 233, 249], "s": [59, 111, 238, 253], "sw": [59, 111, 238, 253], "w": [59, 111, 238, 253], "nw": [55, 133, 238, 273], "n": [55, 133, 238, 273], "ne": [50, 144, 229, 269]}, "atlas": "res://assets/sprites/enemies/ice_glacier_guardian/ice_glacier_guardian_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
