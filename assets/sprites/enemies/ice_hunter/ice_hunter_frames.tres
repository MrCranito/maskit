metadata/enemy_meta = {"kind": "ice_hunter", "name": "Chasseur arctique", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 96, "head_px": 55, "fps": {"idle": 7, "run": 15, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [158.7, 65.0], "se": [153.7, 102.1], "s": [114.9, 125.7], "sw": [65.1, 122.0], "w": [33.3, 93.2], "nw": [38.3, 56.1], "n": [77.1, 32.5], "ne": [126.9, 36.2]}, "corpse_bbox_px": {"e": [0, 88, 152, 162], "se": [0, 88, 152, 162], "s": [40, 62, 166, 168], "sw": [40, 63, 166, 168], "w": [40, 62, 166, 168], "nw": [40, 91, 192, 176], "n": [40, 91, 192, 176], "ne": [27, 103, 152, 179]}, "atlas": "res://assets/sprites/enemies/ice_hunter/ice_hunter_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
