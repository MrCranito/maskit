metadata/enemy_meta = {"kind": "ice_spider", "name": "Araignée polaire", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 128, "head_px": 81, "fps": {"idle": 7, "run": 18, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [173.1, 141.4], "se": [155.2, 173.5], "s": [112.0, 186.8], "sw": [68.8, 173.5], "w": [50.9, 141.4], "nw": [68.8, 109.3], "n": [112.0, 96.0], "ne": [155.2, 109.3]}, "corpse_bbox_px": {"e": [54, 93, 155, 171], "se": [60, 97, 153, 174], "s": [84, 97, 167, 180], "sw": [84, 102, 170, 184], "w": [69, 115, 170, 207], "nw": [71, 113, 164, 209], "n": [57, 101, 140, 194], "ne": [54, 93, 140, 190]}, "atlas": "res://assets/sprites/enemies/ice_spider/ice_spider_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
