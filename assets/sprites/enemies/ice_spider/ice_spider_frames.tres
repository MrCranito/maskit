metadata/enemy_meta = {"kind": "ice_spider", "name": "Araignée polaire", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 135, "head_px": 76, "fps": {"idle": 7, "run": 18, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [191.8, 133.7], "se": [168.5, 175.7], "s": [112.0, 193.1], "sw": [55.5, 175.7], "w": [32.2, 133.7], "nw": [55.5, 91.8], "n": [112.0, 74.4], "ne": [168.5, 91.8]}, "corpse_bbox_px": {"e": [67, 86, 167, 164], "se": [71, 92, 178, 166], "s": [88, 107, 172, 188], "sw": [83, 107, 172, 188], "w": [56, 115, 157, 210], "nw": [46, 111, 153, 215], "n": [52, 94, 136, 202], "ne": [52, 85, 140, 180]}, "atlas": "res://assets/sprites/enemies/ice_spider/ice_spider_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
