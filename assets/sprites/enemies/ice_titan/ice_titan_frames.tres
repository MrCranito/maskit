metadata/enemy_meta = {"kind": "ice_titan", "name": "Le Titan de glace", "frame_size": [276, 276], "feet_offset": [138, 196], "display_height": 221.5, "world_per_px": 0.802609, "height_px": 145, "head_px": 67, "fps": {"idle": 6, "run": 9, "attack": 12, "hit": 14, "death": 9}, "frames": {"idle": 4, "run": 6, "attack": 6, "hit": 3, "death": 6}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [176.8, 203.9], "se": [147.2, 218.7], "s": [112.2, 213.6], "sw": [92.3, 191.6], "w": [99.2, 165.6], "nw": [128.8, 150.9], "n": [163.8, 156.0], "ne": [183.7, 178.0]}, "corpse_bbox_px": {"e": [19, 107, 233, 243], "se": [19, 107, 233, 243], "s": [46, 90, 256, 249], "sw": [46, 90, 256, 249], "w": [46, 90, 256, 249], "nw": [43, 120, 257, 276], "n": [43, 120, 257, 276], "ne": [20, 129, 230, 276]}, "atlas": "res://assets/sprites/enemies/ice_titan/ice_titan_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
