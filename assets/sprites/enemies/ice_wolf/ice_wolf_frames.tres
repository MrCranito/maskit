metadata/enemy_meta = {"kind": "ice_wolf", "name": "Loup des glaces", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 119, "head_px": 75, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [221.6, 105.2], "se": [189.5, 162.8], "s": [112.0, 186.6], "sw": [34.5, 162.8], "w": [2.4, 105.2], "nw": [34.5, 47.6], "n": [112.0, 23.8], "ne": [189.5, 47.6]}, "corpse_bbox_px": {"e": [48, 77, 209, 174], "se": [48, 77, 209, 174], "s": [47, 121, 204, 222], "sw": [47, 121, 204, 222], "w": [47, 121, 204, 222], "nw": [15, 117, 176, 208], "n": [15, 117, 176, 208], "ne": [20, 66, 177, 170]}, "atlas": "res://assets/sprites/enemies/ice_wolf/ice_wolf_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
