metadata/enemy_meta = {"kind": "ice_wolf", "name": "Loup des glaces", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 116, "head_px": 79, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [219.3, 107.0], "se": [187.9, 163.4], "s": [112.0, 186.7], "sw": [36.1, 163.4], "w": [4.7, 107.0], "nw": [36.1, 50.6], "n": [112.0, 27.2], "ne": [187.9, 50.6]}, "corpse_bbox_px": {"e": [48, 72, 213, 175], "se": [48, 72, 213, 175], "s": [49, 115, 201, 224], "sw": [49, 115, 201, 224], "w": [49, 115, 201, 224], "nw": [11, 111, 176, 210], "n": [11, 111, 176, 210], "ne": [23, 56, 175, 171]}, "atlas": "res://assets/sprites/enemies/ice_wolf/ice_wolf_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
