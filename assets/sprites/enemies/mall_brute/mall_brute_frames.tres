metadata/enemy_meta = {"kind": "mall_brute", "name": "Gros brute", "frame_size": [256, 256], "feet_offset": [128, 181], "display_height": 147.7, "world_per_px": 0.576875, "height_px": 106, "head_px": 90, "fps": {"idle": 7, "run": 10, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [158.0, 175.1], "se": [134.6, 186.4], "s": [107.3, 182.0], "sw": [92.1, 164.6], "w": [98.0, 144.3], "nw": [121.4, 133.0], "n": [148.7, 137.4], "ne": [163.9, 154.8]}, "corpse_bbox_px": {"e": [41, 108, 206, 220], "se": [41, 108, 206, 220], "s": [53, 95, 214, 225], "sw": [53, 95, 214, 225], "w": [53, 95, 214, 225], "nw": [50, 120, 215, 244], "n": [50, 120, 215, 244], "ne": [42, 127, 203, 239]}, "atlas": "res://assets/sprites/enemies/mall_brute/mall_brute_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
