metadata/enemy_meta = {"kind": "mall_brute", "name": "Gros brute", "frame_size": [256, 256], "feet_offset": [128, 181], "display_height": 147.7, "world_per_px": 0.576875, "height_px": 116, "head_px": 80, "fps": {"idle": 7, "run": 10, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [158.9, 174.5], "se": [135.3, 186.2], "s": [107.5, 182.2], "sw": [91.7, 164.7], "w": [97.1, 144.1], "nw": [120.7, 132.3], "n": [148.5, 136.3], "ne": [164.3, 153.8]}, "corpse_bbox_px": {"e": [43, 110, 205, 216], "se": [43, 110, 205, 216], "s": [53, 99, 213, 222], "sw": [53, 99, 213, 222], "w": [53, 99, 213, 222], "nw": [50, 120, 213, 243], "n": [50, 120, 213, 243], "ne": [43, 131, 203, 238]}, "atlas": "res://assets/sprites/enemies/mall_brute/mall_brute_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
