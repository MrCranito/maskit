metadata/enemy_meta = {"kind": "mall_clone", "name": "Clone", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 94, "head_px": 51, "fps": {"idle": 7, "run": 15, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [131.3, 88.8], "se": [140.6, 113.4], "s": [123.8, 135.7], "sw": [90.7, 142.6], "w": [60.7, 130.1], "nw": [51.4, 105.5], "n": [68.2, 83.2], "ne": [101.3, 76.3]}, "corpse_bbox_px": {"e": [28, 92, 150, 161], "se": [28, 92, 150, 161], "s": [42, 83, 164, 167], "sw": [42, 83, 164, 167], "w": [42, 83, 164, 167], "nw": [42, 93, 164, 172], "n": [42, 93, 164, 172], "ne": [28, 105, 150, 169]}, "atlas": "res://assets/sprites/enemies/mall_clone/mall_clone_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
