metadata/enemy_meta = {"kind": "mall_flayer", "name": "Écorcheur", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 76, "head_px": 69, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [173.8, 114.2], "se": [137.8, 151.1], "s": [77.4, 158.2], "sw": [27.8, 131.5], "w": [18.2, 86.5], "nw": [54.2, 49.7], "n": [114.6, 42.5], "ne": [164.2, 69.3]}, "corpse_bbox_px": {"e": [17, 79, 151, 160], "se": [17, 79, 151, 160], "s": [41, 85, 172, 167], "sw": [41, 85, 172, 167], "w": [41, 85, 172, 167], "nw": [41, 93, 175, 170], "n": [41, 93, 175, 170], "ne": [18, 105, 151, 173]}, "atlas": "res://assets/sprites/enemies/mall_flayer/mall_flayer_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
