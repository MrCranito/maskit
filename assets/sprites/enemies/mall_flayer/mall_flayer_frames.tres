metadata/enemy_meta = {"kind": "mall_flayer", "name": "Écorcheur", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 73, "head_px": 77, "fps": {"idle": 7, "run": 16, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [185.3, 114.9], "se": [145.8, 157.7], "s": [77.2, 167.3], "sw": [19.5, 137.9], "w": [6.7, 86.9], "nw": [46.2, 44.1], "n": [114.8, 34.5], "ne": [172.5, 63.9]}, "corpse_bbox_px": {"e": [3, 70, 150, 161], "se": [3, 70, 150, 161], "s": [41, 83, 187, 168], "sw": [41, 83, 187, 168], "w": [41, 83, 187, 168], "nw": [42, 92, 189, 170], "n": [42, 92, 189, 170], "ne": [5, 106, 151, 180]}, "atlas": "res://assets/sprites/enemies/mall_flayer/mall_flayer_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
