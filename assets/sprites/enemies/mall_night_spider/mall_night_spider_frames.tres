metadata/enemy_meta = {"kind": "mall_night_spider", "name": "Nuit blanche", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 132, "head_px": 57, "fps": {"idle": 7, "run": 18, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [143.8, 123.4], "se": [129.8, 148.5], "s": [96.0, 158.9], "sw": [62.2, 148.5], "w": [48.2, 123.4], "nw": [62.2, 98.3], "n": [96.0, 87.9], "ne": [129.8, 98.3]}, "corpse_bbox_px": {"e": [38, 68, 130, 149], "se": [42, 72, 133, 150], "s": [67, 75, 155, 153], "sw": [67, 78, 157, 163], "w": [62, 86, 154, 186], "nw": [59, 72, 150, 188], "n": [37, 64, 125, 173], "ne": [35, 65, 125, 169]}, "atlas": "res://assets/sprites/enemies/mall_night_spider/mall_night_spider_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
