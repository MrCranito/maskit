metadata/enemy_meta = {"kind": "mall_night_spider", "name": "Nuit blanche", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 139, "head_px": 45, "fps": {"idle": 7, "run": 18, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [145.4, 125.2], "se": [130.9, 151.2], "s": [96.0, 161.9], "sw": [61.1, 151.2], "w": [46.6, 125.2], "nw": [61.1, 99.3], "n": [96.0, 88.5], "ne": [130.9, 99.3]}, "corpse_bbox_px": {"e": [22, 73, 126, 158], "se": [29, 78, 129, 151], "s": [59, 65, 149, 155], "sw": [70, 67, 153, 159], "w": [66, 89, 170, 181], "nw": [63, 90, 163, 182], "n": [43, 79, 133, 186], "ne": [39, 73, 122, 181]}, "atlas": "res://assets/sprites/enemies/mall_night_spider/mall_night_spider_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
