metadata/enemy_meta = {"kind": "mall_security_bot", "name": "Sécurité robot", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 101, "head_px": 45, "fps": {"idle": 7, "run": 12, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [131.9, 83.0], "se": [118.4, 101.0], "s": [91.8, 106.6], "sw": [67.6, 96.6], "w": [60.1, 76.8], "nw": [73.6, 58.8], "n": [100.2, 53.2], "ne": [124.4, 63.2]}, "corpse_bbox_px": {"e": [28, 88, 154, 164], "se": [28, 88, 154, 164], "s": [39, 77, 163, 169], "sw": [39, 77, 163, 169], "w": [39, 77, 163, 169], "nw": [38, 89, 164, 175], "n": [38, 89, 164, 175], "ne": [29, 101, 153, 173]}, "atlas": "res://assets/sprites/enemies/mall_security_bot/mall_security_bot_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
