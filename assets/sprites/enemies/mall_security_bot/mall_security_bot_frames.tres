metadata/enemy_meta = {"kind": "mall_security_bot", "name": "Sécurité robot", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 98, "head_px": 48, "fps": {"idle": 7, "run": 12, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [133.8, 81.9], "se": [119.9, 100.8], "s": [91.9, 106.9], "sw": [66.4, 96.6], "w": [58.2, 75.8], "nw": [72.1, 56.8], "n": [100.1, 50.7], "ne": [125.6, 61.1]}, "corpse_bbox_px": {"e": [24, 86, 155, 165], "se": [24, 86, 155, 165], "s": [38, 75, 161, 170], "sw": [38, 75, 161, 170], "w": [38, 75, 161, 170], "nw": [37, 88, 168, 177], "n": [37, 88, 168, 177], "ne": [31, 101, 154, 175]}, "atlas": "res://assets/sprites/enemies/mall_security_bot/mall_security_bot_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
