metadata/enemy_meta = {"kind": "mall_violent", "name": "Le Violent", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 92, "head_px": 78, "fps": {"idle": 7, "run": 15, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [190.3, 98.0], "se": [189.9, 146.1], "s": [143.9, 179.9], "sw": [79.2, 179.6], "w": [33.7, 145.4], "nw": [34.1, 97.3], "n": [80.1, 63.5], "ne": [144.8, 63.8]}, "corpse_bbox_px": {"e": [27, 86, 178, 188], "se": [27, 86, 178, 188], "s": [48, 92, 200, 194], "sw": [48, 92, 200, 194], "w": [48, 92, 200, 194], "nw": [46, 107, 197, 207], "n": [46, 107, 197, 207], "ne": [24, 120, 176, 203]}, "atlas": "res://assets/sprites/enemies/mall_violent/mall_violent_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
