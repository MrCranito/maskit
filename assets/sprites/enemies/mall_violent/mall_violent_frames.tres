metadata/enemy_meta = {"kind": "mall_violent", "name": "Le Violent", "frame_size": [224, 224], "feet_offset": [112, 159], "display_height": 129.2, "world_per_px": 0.576875, "height_px": 95, "head_px": 75, "fps": {"idle": 7, "run": 15, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [196.8, 94.4], "se": [197.3, 146.8], "s": [147.9, 184.1], "sw": [77.4, 184.5], "w": [27.2, 147.7], "nw": [26.7, 95.4], "n": [76.1, 58.1], "ne": [146.6, 57.7]}, "corpse_bbox_px": {"e": [16, 85, 178, 189], "se": [16, 85, 178, 189], "s": [48, 92, 203, 196], "sw": [48, 92, 203, 196], "w": [48, 92, 203, 196], "nw": [47, 106, 207, 207], "n": [47, 106, 207, 207], "ne": [22, 119, 176, 214]}, "atlas": "res://assets/sprites/enemies/mall_violent/mall_violent_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
