metadata/enemy_meta = {"kind": "mall_zombie", "name": "Zombie", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 87, "head_px": 58, "fps": {"idle": 7, "run": 9, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [129.3, 118.3], "se": [109.9, 132.8], "s": [82.4, 132.9], "sw": [62.8, 118.5], "w": [62.7, 98.1], "nw": [82.1, 83.5], "n": [109.6, 83.5], "ne": [129.2, 97.9]}, "corpse_bbox_px": {"e": [30, 89, 151, 161], "se": [30, 89, 151, 161], "s": [41, 85, 161, 168], "sw": [41, 85, 161, 168], "w": [41, 85, 161, 168], "nw": [41, 92, 162, 172], "n": [41, 92, 162, 172], "ne": [31, 105, 151, 170]}, "atlas": "res://assets/sprites/enemies/mall_zombie/mall_zombie_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la griffe (image attack 3)."}
