metadata/enemy_meta = {"kind": "outlaw_knife", "name": "Bandit au couteau", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 104, "head_px": 42, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [139.1, 108.0], "se": [131.6, 132.3], "s": [103.2, 145.5], "sw": [70.6, 139.9], "w": [52.9, 118.8], "nw": [60.4, 94.5], "n": [88.8, 81.3], "ne": [121.4, 86.9]}, "corpse_bbox_px": {"e": [22, 87, 148, 161], "se": [22, 87, 148, 161], "s": [45, 84, 169, 166], "sw": [45, 84, 169, 166], "w": [45, 84, 169, 166], "nw": [44, 95, 170, 177], "n": [44, 95, 170, 177], "ne": [23, 106, 147, 174]}, "atlas": "res://assets/sprites/enemies/outlaw_knife/outlaw_knife_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la lame (image attack 3)."}
