metadata/enemy_meta = {"kind": "rifleman", "name": "Tireur embusqué", "frame_size": [192, 192], "feet_offset": [96, 136], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 125, "head_px": 30, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [158.0, 73.8], "se": [139.9, 106.4], "s": [96.1, 120.0], "sw": [52.3, 106.6], "w": [34.0, 74.0], "nw": [52.1, 41.4], "n": [95.9, 27.8], "ne": [139.7, 41.3]}, "corpse_bbox_px": {"e": [16, 74, 150, 162], "se": [16, 74, 150, 162], "s": [43, 70, 175, 167], "sw": [43, 70, 175, 167], "w": [43, 70, 175, 167], "nw": [42, 93, 176, 189], "n": [42, 93, 176, 189], "ne": [17, 96, 149, 186]}, "atlas": "res://assets/sprites/enemies/rifleman/rifleman_atlas.png", "notes": "display_height = hauteur du cadre (frame_size.y px) en unités monde ; scale = display_height / frame_size.y. feet_offset = pieds (px depuis le coin haut-gauche du cadre). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : la dernière image est le cadavre au sol. muzzle_px = bout du canon / de la lame (image attack 3)."}
