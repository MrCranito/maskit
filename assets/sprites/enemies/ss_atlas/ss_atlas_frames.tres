metadata/enemy_meta = {"kind": "ss_atlas", "name": "Le Sécurité Atlas", "frame_size": [256, 256], "feet_offset": [128, 184], "display_height": 147.7, "world_per_px": 0.576875, "height_px": 155, "head_px": 63, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [247.8, 78.1], "se": [210.5, 140.3], "s": [124.9, 164.8], "sw": [41.1, 137.1], "w": [8.2, 73.4], "nw": [45.5, 11.1], "n": [131.1, -13.3], "ne": [214.9, 14.4]}, "corpse_bbox_px": {"e": [10, 84, 198, 224], "se": [10, 84, 198, 224], "s": [58, 88, 241, 226], "sw": [58, 88, 241, 226], "w": [58, 88, 241, 226], "nw": [58, 119, 246, 255], "n": [58, 119, 246, 255], "ne": [15, 101, 198, 256]}, "atlas": "res://assets/sprites/enemies/ss_atlas/ss_atlas_atlas.png", "notes": "Bestiaire Station spatiale (art/blender/bestiary/space_station/build_ss_enemies.py). display_height = hauteur du cadre en unités monde ; feet_offset = pieds (px). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : dernière image = carcasse."}
