metadata/enemy_meta = {"kind": "ss_teleporter", "name": "Téléporteur", "frame_size": [192, 192], "feet_offset": [96, 144], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 110, "head_px": 51, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [142.6, 84.5], "se": [154.0, 116.7], "s": [131.3, 145.4], "sw": [88.0, 153.8], "w": [49.4, 137.0], "nw": [38.0, 104.8], "n": [60.7, 76.1], "ne": [104.0, 67.7]}, "corpse_bbox_px": {"e": [11, 80, 154, 166], "se": [11, 80, 154, 166], "s": [38, 77, 180, 159], "sw": [38, 77, 180, 159], "w": [38, 77, 180, 159], "nw": [38, 100, 181, 186], "n": [38, 100, 181, 186], "ne": [12, 87, 154, 184]}, "atlas": "res://assets/sprites/enemies/ss_teleporter/ss_teleporter_atlas.png", "notes": "Bestiaire Station spatiale (art/blender/bestiary/space_station/build_ss_enemies.py). display_height = hauteur du cadre en unités monde ; feet_offset = pieds (px). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : dernière image = carcasse."}
