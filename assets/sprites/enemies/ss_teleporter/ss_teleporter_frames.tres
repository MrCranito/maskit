metadata/enemy_meta = {"kind": "ss_teleporter", "name": "Téléporteur", "frame_size": [192, 192], "feet_offset": [96, 144], "display_height": 110.8, "world_per_px": 0.576875, "height_px": 86, "head_px": 75, "fps": {"idle": 7, "run": 14, "attack": 12, "hit": 14, "death": 12}, "frames": {"idle": 6, "run": 8, "attack": 6, "hit": 3, "death": 8}, "loop": {"idle": true, "run": true, "attack": false, "hit": false, "death": false}, "directions": ["e", "se", "s", "sw", "w", "nw", "n", "ne"], "attack_hold_frame": 2, "attack_strike_frame": 3, "muzzle_px": {"e": [147.1, 85.4], "se": [158.7, 120.5], "s": [133.6, 151.4], "sw": [86.4, 160.0], "w": [44.9, 141.3], "nw": [33.3, 106.2], "n": [58.4, 75.4], "ne": [105.6, 66.7]}, "corpse_bbox_px": {"e": [17, 75, 155, 167], "se": [17, 75, 155, 167], "s": [37, 72, 175, 161], "sw": [37, 72, 175, 161], "w": [37, 72, 175, 161], "nw": [38, 101, 175, 188], "n": [38, 101, 175, 188], "ne": [16, 87, 155, 184]}, "atlas": "res://assets/sprites/enemies/ss_teleporter/ss_teleporter_atlas.png", "notes": "Bestiaire Station spatiale (art/blender/bestiary/space_station/build_ss_enemies.py). display_height = hauteur du cadre en unités monde ; feet_offset = pieds (px). attack : 0-2 élan (2 tenue pendant le télégraphe), 3 coup/tir, 4-5 retour. death : dernière image = carcasse."}
