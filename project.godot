; Engine configuration file.
config_version=5

[application]

config/name="RaidersGo"
run/main_scene="res://scenes/ui/menus/splash.tscn"
run/max_fps=120
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/menu/app_icon_1024.png"
boot_splash/bg_color=Color(0.035, 0.035, 0.07, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/ui/splash/boot.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
Balance="*res://scripts/core/balance.gd"
InputSetup="*res://scripts/core/input_setup.gd"
GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/save/save_manager.gd"
Profile="*res://scripts/core/profile.gd"
BattlePass="*res://scripts/progression/battle_pass.gd"
LootManager="*res://scripts/loot/loot_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
CloudSync="*res://scripts/net/cloud_sync.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_projectiles"
2d_physics/layer_5="enemy_projectiles"
2d_physics/layer_6="interactables"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.07, 0.1, 0.18, 1)
textures/vram_compression/import_etc2_astc=true
